# 复制这个文件为 .env（去掉 .example 后缀），填入你自己的密钥。
# .env 已被 .gitignore 排除，不会进 Git 仓库 —— 千万别把密钥提交上去。

# ---- DeepSeek（OpenAI 兼容协议）----
# 控制台 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-在这里填你的密钥

# 下面三个都可以不填，代码里有默认值
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# 想换厂商时只需要改这三行，业务代码一行都不用动：
#   智谱    DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#           DEEPSEEK_MODEL=glm-4-flash
#   通义    DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#           DEEPSEEK_MODEL=qwen-plus
